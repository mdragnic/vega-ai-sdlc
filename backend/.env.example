# Copy to backend/.env (gitignored). Every variable the backend reads is listed here.
# Variables already set in the environment win over this file.

# development | test | production. `test` uses backend/data/finebank.test.sqlite.
NODE_ENV=development

# Only with NODE_ENV=test: the instant the fixed clock starts at (ISO, UTC).
# Default: 2026-10-22T10:00:00Z, the same as FIXED_NOW in e2e/constants.ts.
TEST_NOW=2026-10-22T10:00:00Z

# Google sign-in (#75, #102): a Google OAuth client created with the redirect URI
# http://localhost:5173/api/auth/google/callback. Empty means "Continue with Google" fails and
# returns to Login with "Google sign-in failed. Please try again." Tests always use the fake
# Google client (NODE_ENV=test), whatever these say. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
