{
  "name": "@finebank/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "nest build && typeorm migration:run -d dist/database/data-source.js",
    "migration:generate": "nest build && node scripts/migration-generate.js",
    "start:e2e": "nest build && node dist/database/reset-test-database.js && node dist/main.js"
  },
  "dependencies": {
    "@finebank/shared": "0.0.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/typeorm": "12.0.2",
    "better-sqlite3": "12.11.1",
    "google-auth-library": "11.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.18",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
